{
  "_comment": "Example project-scoped .mcp.json — copy to your repo root as .mcp.json. Values come from the environment via ${VAR}; NEVER paste a real token here, this file is meant to be committed.",

  "mcpServers": {
    "orders-baseline": {
      "command": "python",
      "args": ["skeletons/01_tools_only.py"]
    },

    "policy-catalogue": {
      "command": "python",
      "args": ["skeletons/02_resources.py"]
    },

    "configured-api": {
      "command": "python",
      "args": ["skeletons/07_env_config.py"],
      "env": {
        "API_TOKEN": "${API_TOKEN}",
        "API_BASE": "${API_BASE:-https://api.example.com}",
        "API_TIMEOUT": "30"
      }
    },

    "remote-http-example": {
      "type": "http",
      "url": "https://mcp.example.com/v1",
      "headers": {
        "Authorization": "Bearer ${REMOTE_MCP_TOKEN}"
      }
    }
  }
}
